GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Telegram bot — optional
# Get token from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL where this server is reachable (e.g. ngrok or your VPS)
WEBHOOK_URL=

# Flight search — optional sources
# SerpAPI (Google Flights wrapper) — 100 free searches/month
# Get key at: https://serpapi.com/
SERPAPI_KEY=

# Skyscanner via RapidAPI — requires paid plan
# Get key at: https://rapidapi.com/skyscanner/api/skyscanner-flight-search
RAPIDAPI_KEY=

# AviationStack — real-time flight status (500 free requests/month)
# Used by the flight tracker to monitor partner's flights and send landing alerts
# Get key at: https://aviationstack.com/
AVIATIONSTACK_KEY=

# Stock analyzer — required for the Buffett-style analysis module
# NewsAPI: https://newsapi.org/  (free tier; primary source)
NEWS_API_KEY=
# GNews: https://gnews.io/  (free tier; fallback when NewsAPI is empty/unset)
GNEWS_API_KEY=
# Alpha Vantage: https://www.alphavantage.co/  (free tier, 25 req/day)
ALPHA_VANTAGE_KEY=
# Telegram chat ID for stock alerts. Defaults to TELEGRAM_ALLOWED_USER_ID if unset.
TELEGRAM_CHAT_ID=
# FRED (St. Louis Fed) — optional, free with registration: https://fred.stlouisfed.org/docs/api/api_key.html
# Used by the macro context module for rates / CPI / unemployment / yield curve.
# Without it the system falls back to yfinance ^IRX/^TNX/^FVX proxies.
FRED_API_KEY=
